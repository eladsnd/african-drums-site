# Sanity (optional — site works with fallback data without these)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=

# Site URL for sitemap/SEO (set to your domain in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp (Israel, no + or spaces — e.g. 972501234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Contact form (optional — falls back to mailto)
NEXT_PUBLIC_FORMSPREE_ID=

# Studio title
NEXT_PUBLIC_SANITY_PROJECT_TITLE=ניהול אתר — תיפוף אפריקאי
